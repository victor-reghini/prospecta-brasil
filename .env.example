# Servidor HTTP
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://prospecta:prospecta@localhost:5432/prospecta_brasil

# Stripe
STRIPE_SECRET_KEY=sk_test_substitua_aqui
STRIPE_WEBHOOK_SECRET=whsec_substitua_aqui

# Storage S3 / Cloudflare R2 (opcional em dev; se vazio, salva em ./exports)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_EXPORT_DIR=./exports

# Autenticacao simplificada para desenvolvimento local
DEV_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
DEV_DEFAULT_USER_EMAIL=demo@prospectabrasil.local

# Pipeline ETL Dados Abertos RFB
RFB_DATA_DIR=./data/rfb
RFB_DOWNLOAD_REMOTE=false
RFB_BASE_URL=https://arquivos.receitafederal.gov.br/dados/cnpj/dados_abertos_cnpj/
ETL_SYNC_INTERVAL_HOURS=0
