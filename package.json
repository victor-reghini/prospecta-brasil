{
  "name": "prospecta-brasil",
  "version": "0.1.0",
  "description": "Plataforma de prospecção B2B baseada nos dados abertos da Receita Federal (RFB) com precificação progressiva e checkout via Stripe.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "etl:rfb": "tsx src/etl-rfb.ts",
    "etl:rfb:watch": "tsx src/etl-rfb.ts --watch",
    "test": "tsc && node --test dist/test/platform.test.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "b2b",
    "prospecting",
    "cnpj",
    "rfb",
    "stripe",
    "postgresql",
    "streaming"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/lib-storage": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-csv": "^5.0.2",
    "pg": "^8.13.1",
    "pg-query-stream": "^4.7.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
